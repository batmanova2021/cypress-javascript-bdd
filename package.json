{
  "name": "cypress-javascript-bdd",
  "version": "1.0.0",
  "description": "Sauce Demo automation portfolio with Cypress, Cucumber BDD, and JavaScript",
  "scripts": {
    "cy:open": "cypress open",
    "test": "node scripts/run-tests.js regression",
    "test:smoke": "node scripts/run-tests.js smoke",
    "test:regression": "node scripts/run-tests.js regression",
    "test:chrome": "node scripts/run-tests.js regression chrome",
    "test:firefox": "node scripts/run-tests.js regression firefox",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": [
      "cypress/step_definitions/**/*.js"
    ],
    "filterSpecs": true,
    "omitFiltered": true
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^28.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@eslint/js": "^10.0.1",
    "cypress": "^16.2.0",
    "cypress-mochawesome-reporter": "^5.0.0",
    "cypress-on-fix": "^1.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^7.0.2",
    "prettier": "^3.9.10",
    "prettier-plugin-gherkin": "^4.0.0"
  }
}
